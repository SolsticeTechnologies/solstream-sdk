{
  "name": "Solstream SDK",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "zxh404.vscode-proto3",
        "mikestead.dotenv"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.preferences.importModuleSpecifier": "relative",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Run once after the container is created
  "postCreateCommand": "bash .devcontainer/post-install.sh",

  // Open the test-app folder in the terminal by default
  "postStartCommand": "echo '\\n  👋  Welcome to the Solstream SDK dev environment!\\n  Run: cp test-app/.env.example test-app/.env  then fill in your endpoint + API key.\\n  Then: cd test-app && npm run test:slots\\n'",

  "remoteUser": "node",

  "forwardPorts": [],

  "mounts": []
}
