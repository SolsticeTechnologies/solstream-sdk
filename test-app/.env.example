# Copy this file to .env and fill in your values
SOLSTREAM_ENDPOINT=https://your-endpoint-here
SOLSTREAM_API_KEY=your-api-key-here

# How long each test runs before auto-stopping (seconds, default: 30)
TEST_DURATION_SECS=30

# Email alerts via AWS SES (optional)
# Leave blank to disable alerts
ALERT_FROM=alerts@yourdomain.com
ALERT_TO=you@yourdomain.com,teammate@yourdomain.com
AWS_REGION=us-east-1
# How long the stream must be silent before an alert is sent (seconds, default: 60)
ALERT_SILENCE_SECS=60
